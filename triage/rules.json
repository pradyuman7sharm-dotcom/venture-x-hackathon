  "rules": [
    {
      "id": "GDS-001",
      "patient_groups": ["child", "newborn"],
      "name": "General Danger Signs",
      "symptoms": ["convulsions", "unable_to_drink", "vomiting_everything", "lethargy", "unconscious"],
      "match": "any",
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - General Danger Signs, Chart Booklet Module 1",
      "explanation_key": "general_danger_signs"
    },
    {
      "id": "ARI-001",
      "patient_groups": ["child"],
      "name": "Severe Pneumonia or Very Severe Disease",
      "symptoms": ["chest_indrawing", "stridor"],
      "match": "any",
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - Cough or Difficult Breathing, Chart Booklet Module 2",
      "explanation_key": "severe_pneumonia"
    },
    {
      "id": "ARI-002",
      "patient_groups": ["child"],
      "name": "Pneumonia",
      "symptoms": ["fast_breathing"],
      "match": "any",
      "risk": "CLINIC_VISIT",
      "protocol_ref": "WHO IMNCI - Cough or Difficult Breathing, Chart Booklet Module 2",
      "explanation_key": "pneumonia"
    },
    {
      "id": "DIA-001",
      "patient_groups": ["child"],
      "name": "Severe Dehydration",
      "symptoms": ["diarrhoea", "sunken_eyes", "skin_pinch_slow", "unable_to_drink"],
      "match": "all_of",
      "match_required": ["diarrhoea"],
      "match_additional_any": ["sunken_eyes", "skin_pinch_slow", "unable_to_drink"],
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - Diarrhoea, Chart Booklet Module 3",
      "explanation_key": "severe_dehydration"
    },
    {
      "id": "DIA-002",
      "patient_groups": ["child"],
      "name": "Some Dehydration",
      "symptoms": ["diarrhoea", "restless", "irritable", "drinks_eagerly"],
      "match": "all_of",
      "match_required": ["diarrhoea"],
      "match_additional_any": ["restless", "irritable", "drinks_eagerly"],
      "risk": "CLINIC_VISIT",
      "protocol_ref": "WHO IMNCI - Diarrhoea, Chart Booklet Module 3",
      "explanation_key": "some_dehydration"
    },
    {
      "id": "MAL-001",
      "patient_groups": ["child"],
      "name": "Severe Malnutrition",
      "symptoms": ["visible_wasting", "oedema_both_feet"],
      "match": "any",
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - Malnutrition, Chart Booklet Module 5",
      "explanation_key": "severe_malnutrition"
    },
    {
      "id": "FEV-001",
      "patient_groups": ["child"],
      "name": "Very Severe Febrile Disease",
      "symptoms": ["fever", "stiff_neck"],
      "match": "all",
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - Fever, Chart Booklet Module 4",
      "explanation_key": "severe_fever"
    },
    {
      "id": "FEV-002",
      "patient_groups": ["child"],
      "name": "Very Severe Febrile Disease (Fontanelle)",
      "symptoms": ["fever", "bulging_fontanelle"],
      "match": "all",
      "risk": "URGENT_REFERRAL",
      "protocol_ref": "WHO IMNCI - Fever, Chart Booklet Module 4",
      "explanation_key": "severe_fever",
      "age_condition": {"min_months": 0, "max_months": 18}
